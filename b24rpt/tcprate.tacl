?TACL MACRO
== ==================================================================
== TCPRATE - egy port TCP kapcsolatainak forgalma a CLIM-eken
==
== Hasznalat:
==   LOAD /KEEP 1/ $DATA.EMSRPT.TCPRMAC
==   TCPRATE port [namespace] [mp]
==
==   port       a figyelt port (pl. 4275 = ATM, 7000 = HSM); mindket
==              iranyt nezi (dport es sport), igy mindegy, ki a szerver
==   namespace  CLIM hálozati nevter (pl. NMLNS005); ha nincs megadva
==              vagy *, akkor a CLIM-ek osszes nevteret vegignezi
==   mp         meresi ido masodpercben (alap: 60)
==
== Peldak:
==   TCPRATE 4275                 == ATM, minden nevter, 60 mp
==   TCPRATE 7000 NMLNS006        == HSM, adott nevter
==   TCPRATE 4275 * 30            == minden nevter, 30 mp
==
== Mukodes: ket pillanatkep (climcmd ... ss -tin) a megadott ido
== kulonbseggel, majd a TCPRATE program kiszamolja a kapcsolatonkenti
== uzenet/mp erteket (data_segs_in/out kulonbseg).
==
== A BEALLITASOK reszben add meg a CLIM-ek nevet es a program helyet!
== ==================================================================
?SECTION tcprate MACRO
#FRAME
#PUSH clims prog port ns sec pairs all out nl rest cl nsn ln i k pass
== ---------------------- BEALLITASOK ----------------------
#SET clims nclim000 nclim001          == CLIM-ek, szokozzel elvalasztva
#SET prog  $DATA.EMSRPT.TCPRATE       == a TCPRATE program
== ---------------------------------------------------------
#SET port %1%
#SET ns   %2%
#SET sec  %3%
[#IF [#EMPTYV sec] |THEN| #SET sec 60]
[#IF [#EMPTYV ns] |THEN| #SET ns *]

[#IF [#EMPTYV port] |THEN|
  #OUTPUT Hasznalat: TCPRATE port [namespace] [mp]
|ELSE|

  == 1. CLIM / nevter parok osszegyujtese
  #SET rest [clims]
  [#LOOP |WHILE| NOT [#EMPTYV rest] |DO|
    #SET rest [#SETMANY cl , [rest]]
    [#IF ns '=' "*" |THEN|
      #SET nl
      climcmd /OUTV nl/ [cl] ip netns list
      #SET i 1
      [#LOOP |WHILE| i <= [#LINECOUNT nl] |DO|
        #SET ln [#LINEGET nl i]
        #SET nsn
        SINK [#SETMANY nsn , [ln]]
        == csak a nevter-sorok (pl. "NMLNS005 (id: 3)")
        [#IF NOT [#EMPTYV nsn] AND [#CHARFIND ln 1 Termination] = 0 |THEN|
          #APPEND pairs [cl] [nsn]
        ]
        #SET i [#COMPUTE i + 1]
      ]
    |ELSE|
      #APPEND pairs [cl] [ns]
    ]
  ]
  #OUTPUT TCPRATE: port [port], [sec] mp, [#LINECOUNT pairs] CLIM/nevter

  == 2. ket pillanatkep
  #SET pass 1
  [#LOOP |WHILE| pass <= 2 |DO|
    #APPEND all @@T [pass] [#JULIANTIMESTAMP]
    #SET k 1
    [#LOOP |WHILE| k <= [#LINECOUNT pairs] |DO|
      SINK [#SETMANY cl nsn , [#LINEGET pairs k]]
      #SET out
      climcmd /OUTV out/ [cl] ip netns exec [nsn] ss -tin &
        dport = :[port] or sport = :[port]
      #APPEND all @@S [pass] [cl] [nsn]
      #APPENDV all out
      #SET k [#COMPUTE k + 1]
    ]
    [#IF pass = 1 |THEN|
      #OUTPUT TCPRATE: elso meres kesz, varakozas [sec] mp ...
      #DELAY [#COMPUTE sec * 100]
    ]
    #SET pass [#COMPUTE pass + 1]
  ]

  == 3. kiertekeles
  RUN [prog] /INV all/ [port] [sec]
]
#UNFRAME
