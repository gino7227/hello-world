?TACL MACRO
== ==================================================================
== TCPRATE - egy port TCP kapcsolatainak forgalma a CLIM-eken
==
== Hasznalat:
==   LOAD /KEEP 1/ $DATA.EMSRPT.TCPRMAC
==   TCPRATE port [perc] [namespace] [R]
==
==   port       a figyelt port (pl. 4275 = ATM, 7000 = HSM); mindket
==              iranyt nezi (dport es sport), igy mindegy, ki a szerver
==   perc       meresi ido percben (alap: 5); a makro most indul, ennyit
==              var, es utana irja ki, mennyi uzenet ment at a porton
==   namespace  CLIM halozati nevter (pl. NMLNS005); ha nincs megadva
==              vagy *, akkor a CLIM-ek osszes nevteret vegignezi
==   R          reszletes kimenet kapcsolatonkent is
==
== Peldak:
==   TCPRATE 4275                 == ATM, 5 perc
==   TCPRATE 7000 1               == HSM, 1 perc
==   TCPRATE 4275 10 * R          == ATM, 10 perc, reszletesen
==   TCPRATE 7000 5 NMLNS006      == HSM, 5 perc, adott nevter
==
== Mukodes: ket pillanatkep (climcmd ... ss -tin) a megadott ido
== kulonbseggel, majd a TCPRATE program kiszamolja, hany uzenet
== (data_segs_in/out kulonbseg) ment at a porton a meres alatt.
== Visszamenoleg nem lehet merni: a CLIM csak osszesitett szamlalot ad.
==
== A BEALLITASOK reszben add meg a CLIM-ek nevet es a program helyet!
== ==================================================================
?SECTION climv MACRO
== CLIMV valtozo clim parancs...
== A climcmd csak fajlba tud irni (OUT), valtozoba (OUTV) nem: ezert a
== kimenet a climv^tmp munkafajlba megy, onnan FUP COPY-val a valtozoba.
[#IF [#FILEINFO /EXISTENCE/ [climv^tmp]] |THEN|
  FUP /OUTV climv^junk/ PURGE [climv^tmp]!
]
climcmd /OUT [climv^tmp]/ %2 TO *%
#SET %1%
[#IF [#FILEINFO /EXISTENCE/ [climv^tmp]] |THEN|
  FUP /OUTV %1%/ COPY [climv^tmp]
]

?SECTION climf MACRO
== CLIMF fajl clim parancs...
== A climcmd kimenete fajlba; ezt a TCPRATE program maga olvassa be (@@F),
== mert a FUP COPY a hosszu rekordok veget levagna.
[#IF [#FILEINFO /EXISTENCE/ %1%] |THEN|
  FUP /OUTV climv^junk/ PURGE %1%!
]
climcmd /OUT %1%/ %2 TO *%

?SECTION tcprate MACRO
#FRAME
#PUSH clims prog port ns sec perc rsz pairs all out nl rest cl nsn ln i k pass
#PUSH climv^tmp climv^junk climv^sv kk ctf
== ---------------------- BEALLITASOK ----------------------
#SET clims nclim000 nclim001          == CLIM-ek, szokozzel elvalasztva
#SET prog  $DATA.EMSRPT.TCPRATE       == a TCPRATE program
#SET climv^tmp $DATA.EMSRPT.CLIMTMP   == munkafajl a climcmd kimenetehez
#SET climv^sv  $DATA.EMSRPT            == ide kerulnek a CTpkk munkafajlok
== ---------------------------------------------------------
#SET port %1%
#SET perc %2%
#SET ns   %3%
#SET rsz  %4%
[#IF [#EMPTYV perc] |THEN| #SET perc 5]
[#IF [#EMPTYV ns] |THEN| #SET ns *]
#SET sec [#COMPUTE perc * 60]

[#IF [#EMPTYV port] |THEN|
  #OUTPUT Hasznalat: TCPRATE port [perc] [namespace] [R]
|ELSE|

  == 1. CLIM / nevter parok osszegyujtese
  #SET rest [clims]
  [#LOOP |WHILE| NOT [#EMPTYV rest] |DO|
    #SET rest [#SETMANY cl , [rest]]
    [#IF ns '=' "*" |THEN|
      CLIMV nl [cl] ip netns list
      #SET i 1
      [#LOOP |WHILE| i <= [#LINECOUNT nl] |DO|
        #SET ln [#LINEGET nl i]
        #SET nsn
        SINK [#SETMANY nsn , [ln]]
        == csak a nevter-sorok (pl. "NMLNS005 (id: 3)")
        [#IF NOT [#EMPTYV nsn] AND [#CHARFIND ln 1 Termination] = 0 |THEN|
          #APPEND pairs [cl] [nsn]
        ]
        #SET i [#COMPUTE i + 1]
      ]
    |ELSE|
      #APPEND pairs [cl] [ns]
    ]
  ]
  #OUTPUT TCPRATE: port [port], [perc] perc meres indul ([#LINECOUNT pairs] CLIM/nevter)

  == 2. ket pillanatkep
  #SET pass 1
  [#LOOP |WHILE| pass <= 2 |DO|
    #APPEND all @@T [pass] [#JULIANTIMESTAMP]
    #APPEND all @@D [pass] [#CONTIME [#TIMESTAMP]]
    #SET k 1
    [#LOOP |WHILE| k <= [#LINECOUNT pairs] |DO|
      SINK [#SETMANY cl nsn , [#LINEGET pairs k]]
      #SET kk [k]
      [#IF k < 10 |THEN| #SET kk 0[k]]
      #SET ctf [climv^sv].CT[pass][kk]
      CLIMF [ctf] [cl] ip netns exec [nsn] ss -tin &
        dport = :[port] or sport = :[port]
      #APPEND all @@S [pass] [cl] [nsn]
      #APPEND all @@F [ctf]
      #SET k [#COMPUTE k + 1]
    ]
    [#IF pass = 1 |THEN|
      #OUTPUT TCPRATE: varakozas [perc] percig ...
      #DELAY [#COMPUTE sec * 100]
    ]
    #SET pass [#COMPUTE pass + 1]
  ]

  == 3. kiertekeles
  RUN [prog] /INV all/ [port] [sec] [rsz]
]
#UNFRAME
